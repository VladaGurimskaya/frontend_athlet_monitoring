{
  "$schema": "./node_modules/@openapitools/openapi-generator-cli/config.schema.json",
  "spaces": 2,
  "generator-cli": {
    "version": "7.8.0",
    "generators": {
      "root": {
        "input-spec": "../api_athlet_monitoring/athlete_monitoring_api.yaml",
        "generator-name": "javascript",
        "output": "./src/api_athlet_monitoring",
        "additionalProperties": {
          "supportsES6": true,
          "useFetch": true,
          "withSeparateModelsAndApi": true,
          "modelPropertyNaming": "camelCase",
          "apiPackage": "api",
          "modelPackage": "models"
        }
      }
    }
  }
}